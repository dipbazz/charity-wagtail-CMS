# Copy to .env in this folder on the server and fill in. .env is gitignored and dockerignored.

# The site's public hostname. With an Elastic IP of 13.48.1.2, sslip.io gives 13-48-1-2.sslip.io.
SITE_HOST=

# Generate on the server with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# The S3 bucket for nightly backups (deploy/aws/backup.sh writes under backups/).
BACKUP_BUCKET=

# Where the database, uploads and backups live on the server.
DATA_DIR=/srv/charity/data

# Raise to 31536000 (a year) once HTTPS has worked for a while; browsers remember it.
DJANGO_SECURE_HSTS_SECONDS=3600

# The language the site opens in at /: ne (Nepali) or en (English). The other is under /en/ or
# /ne/. Choose before adding content: changing it later changes every page's address.
DJANGO_LANGUAGE_CODE=ne
