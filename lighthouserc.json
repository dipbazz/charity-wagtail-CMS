{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:8000/",
        "http://127.0.0.1:8000/appeals/",
        "http://127.0.0.1:8000/appeals/flood-relief/",
        "http://127.0.0.1:8000/stories/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "extraHeaders": "{\"X-Forwarded-Proto\": \"https\"}"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1, "aggregationMethod": "median"}],
            "largest-contentful-paint": ["warn", {"maxNumericValue": 4000, "aggregationMethod": "median"}],
            "categories:performance": ["warn", {"minScore": 0.8, "aggregationMethod": "median"}]
          }
        },
        {
          "matchingUrlPattern": "^https?://[^/]+/$",
          "assertions": {
            "resource-summary:total:size": ["error", {"maxNumericValue": 221000, "aggregationMethod": "median"}],
            "resource-summary:image:size": ["error", {"maxNumericValue": 196000, "aggregationMethod": "median"}]
          }
        },
        {
          "matchingUrlPattern": "/appeals/$",
          "assertions": {
            "resource-summary:total:size": ["error", {"maxNumericValue": 184000, "aggregationMethod": "median"}],
            "resource-summary:image:size": ["error", {"maxNumericValue": 159000, "aggregationMethod": "median"}]
          }
        },
        {
          "matchingUrlPattern": "/appeals/flood-relief/$",
          "assertions": {
            "resource-summary:total:size": ["error", {"maxNumericValue": 71000, "aggregationMethod": "median"}],
            "resource-summary:image:size": ["error", {"maxNumericValue": 46000, "aggregationMethod": "median"}]
          }
        },
        {
          "matchingUrlPattern": "/stories/$",
          "assertions": {
            "resource-summary:total:size": ["error", {"maxNumericValue": 108000, "aggregationMethod": "median"}],
            "resource-summary:image:size": ["error", {"maxNumericValue": 83000, "aggregationMethod": "median"}]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
