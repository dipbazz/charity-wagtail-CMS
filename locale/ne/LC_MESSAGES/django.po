msgstr "गृहपृष्ठमा फर्कनुहोस्"

#, python-format
msgid "We received %(amount)s from you by %(provider)s (reference %(reference)s)."
msgstr "हामीले तपाईंबाट %(provider)s मार्फत %(amount)s पायौं (सन्दर्भ %(reference)s)।"

#, python-format
msgid "We received %(amount)s from you by %(provider)s."
msgstr "हामीले तपाईंबाट %(provider)s मार्फत %(amount)s पायौं।"

