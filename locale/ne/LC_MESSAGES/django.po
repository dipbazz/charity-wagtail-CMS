msgstr "हाम्रो टोलीले तपाईंलाई सम्पर्क गर्नेछ।"

msgid "Checking your payment"
msgstr "तपाईंको भुक्तानी जाँचिँदैछ"

#, python-format
msgid "Thank you. You've told us you paid %(amount)s by %(name)s on %(date)s. Our team will check it reaches us and mark your gift received."
msgstr "धन्यवाद। तपाईंले %(date)s मा %(name)s बाट %(amount)s भुक्तानी गरेको हामीलाई जानकारी गराउनुभएको छ। हाम्रो सदस्यले तपाईंको दान प्राप्त भए नभएको जाँचेर जनाउनेछन्।"

#, python-format
msgid "You sent us the transaction ID %(id)s and a screenshot of the receipt."
msgstr "तपाईंले Transaction ID %(id)s र रसिदको स्क्रिनसट पठाउनुभएको छ।"

#, python-format
msgid "You sent us the transaction ID %(id)s."
msgstr "तपाईंले पठाउनुभएको Transaction ID %(id)s हो।"

msgid "You sent us a screenshot of the receipt."
msgstr "तपाईंले रसिदको स्क्रिनसट पठाउनुभएको छ।"

#, python-format
msgid "Questions? Call us and give your pledge number, %(number)s:"
msgstr "केही प्रश्न छ? हामीलाई फोन गरेर आफ्नो प्रतिबद्धता नम्बर %(number)s बताउनुहोस्:"

msgid "There's nothing more to do here."
msgstr "यहाँ अरू केही गर्नुपर्दैन।"

msgid "Pay your gift"
msgstr "तपाईंको दान भुक्तानी गर्नुहोस्"

msgid "How would you like to pay?"
msgstr "तपाईं कसरी भुक्तानी गर्न चाहनुहुन्छ?"

msgid "Pay in person"
msgstr "आफैं आएर भुक्तानी गर्नुहोस्"

msgid "You'll pay this month's gift now."
msgstr "यस महिनाको दान अहिले तिर्नुहुनेछ।"

msgid "Come to our office:"
msgstr "हाम्रो कार्यालयमा आउनुहोस्:"

msgid "Call us before you come:"
msgstr "आउनुअघि हामीलाई फोन गर्नुहोस्:"

