msgid "Wherever it's needed most"
msgstr "जहाँ सबैभन्दा बढी आवश्यक छ"

msgid "Choose an amount or enter your own."
msgstr "रकम छान्नुहोस् वा आफ्नै रकम लेख्नुहोस्।"

msgid "Country"
msgstr "देश"

#, python-brace-format
msgid "{typed}/{limit} characters"
msgstr "{typed}/{limit} अक्षर"

#, python-brace-format
msgid "You have {left} characters left."
msgstr "तपाईंसँग {left} अक्षर बाँकी छन्।"

#, python-brace-format
msgid "You've reached the limit of {limit} characters."
msgstr "तपाईं {limit} अक्षरको सीमामा पुग्नुभयो।"

msgid "How often"
msgstr "कति पटक"

msgid "Your name"
msgstr "तपाईंको पुरा नाम"

msgid "Email address"
msgstr "इमेल ठेगाना"

msgid "Which appeal would you like to support?"
msgstr "तपाईं कुन अपिललाई सहयोग गर्न चाहनुहुन्छ?"

msgid "Number"
msgstr "नम्बर"

msgid "Address"
msgstr "ठेगाना"

msgid "Postcode or postal code"
msgstr "हुलाक कोड"

msgid "A message with your gift"
msgstr "तपाईंको दानसँगै सन्देश"

msgid "Email me stories from our projects and appeals that need help"
msgstr "हाम्रा परियोजनाका कथा र सहयोग चाहिएका अपिलहरू मलाई इमेलमा पठाउनुहोस्"

msgid "Show my gift on this website"
msgstr "मेरो दान यस वेबसाइटमा देखाउनुहोस्"

msgid "For example, if you're giving in memory of someone. Only our team will read it."
msgstr "उदाहरणका लागि, कसैको सम्झनामा दान दिँदै हुनुहुन्छ भने। तपाईंको सन्देश हाम्रो संस्थाको सदस्यहरूले मात्र पढ्नेछन्।"

msgid "House or ward number, street or tole, town or municipality, district."
msgstr "घर वा वडा नम्बर, सडक वा टोल, सहर वा नगरपालिका, जिल्ला।"

msgid "You can ask us to stop at any time."
msgstr "तपाईं जुनसुकै बेला हामीलाई भनेर निस्क्रिय गर्न सक्नुहुन्छ।"

msgid "Once your gift reaches us, we'll list your name, the amount, the appeal and the date. Nothing else about you is shown."
msgstr "तपाईंको दान हामीले पाएपछि, हामी तपाईंको नाम, रकम, अपिल र मिति सूचीमा देखाउनेछौं। तपाईंको अरू कुनै जानकारी सम्प्रेषण हुने छैन।"

msgid "We'll only use this to send you a monthly reminder on WhatsApp, or by text message if you're in Nepal and not on WhatsApp."
msgstr "हामी यो नम्बर मासिक सम्झना सन्देश पठाउन मात्र प्रयोग गर्नेछौं: व्हाट्सएपमा, वा तपाईं नेपालमा हुनुहुन्छ र व्हाट्सएप प्रयोग गर्नुहुन्न भने एसएमएसमा।"

msgid "Enter your name."
msgstr "आफ्नो नाम लेख्नुहोस्।"

msgid "Enter your email address."
msgstr "आफ्नो इमेल ठेगाना लेख्नुहोस्।"

msgid "Other amount"
msgstr "अन्य रकम"

#, python-format
msgid "Your own amount (%(currency)s)"
msgstr "तपाईंको आफ्नै रकम (%(currency)s)"

msgid "One-off"
msgstr "एक पटक"

msgid "Monthly"
msgstr "मासिक"

msgid "Choose a suggested amount or type your own, not both."
msgstr "सुझाइएको रकम छान्नुहोस् वा आफ्नै रकम लेख्नुहोस्, दुवै होइन।"

msgid "Which app did you pay with?"
msgstr "तपाईंले कुन एपबाट भुक्तानी गर्नुभयो?"

msgid "Transaction ID"
msgstr "लेनदेन आईडी"

msgid "Enter the transaction ID from your receipt."
msgstr "आफ्नो रसिदमा रहेको लेनदेन आईडी लेख्नुहोस्।"

msgid "Open appeals"
msgstr "खुला अपिलहरू"

msgid "Past appeals"
msgstr "विगतका अपिलहरू"

#, python-format
msgid "%(names)s or %(last)s"
msgstr "%(names)s वा %(last)s"

#, python-format
msgid "with %(names)s"
msgstr "%(names)s बाट"

msgid "by scanning our QR code"
msgstr "हाम्रो QR कोड स्क्यान गरेर"

msgid "in person"
msgstr "आफैं आएर"

#, python-format
msgid "A gift to %(charity)s: %(appeal)s"
msgstr "%(charity)s लाई दान: %(appeal)s"

msgid "Filter appeals"
msgstr "अपिलहरू छान्नुहोस्"

msgid "All appeals"
msgstr "सबै अपिलहरू"

msgid "There are no appeals to show right now."
msgstr "अहिले देखाउनका लागि कुनै अपिल छैन।"

#, python-format
msgid "Appeal closes %(closes)s"
msgstr "अपिल %(closes)s मा बन्द हुन्छ"

msgid "Ongoing appeal"
msgstr "जारी अपिल"

#, python-format
msgid "This appeal closed on %(closed)s. Thank you to everyone who gave."
msgstr "यो अपिल %(closed)s मा बन्द भयो। दान दिनुहुने सबैलाई धन्यवाद।"

msgid "What your gift can do"
msgstr "तपाईंको दानले के गर्न सक्छ"

msgid "Donate to this appeal"
msgstr "यो अपिलमा दान दिनुहोस्"

#, python-format
msgid "After you send this form, you can pay %(how_to_pay)s."
msgstr "यो फारम पठाएपछि तपाईं %(how_to_pay)s भुक्तानी गर्न सक्नुहुन्छ।"

#, python-format
msgid "After you send this form, you can pay with %(pay_with)s, or in person."
msgstr "यो फारम पठाएपछि तपाईं %(pay_with)s बाट, वा आफैं आएर भुक्तानी गर्न सक्नुहुन्छ।"

#, python-format
msgid "After you send this form, you can pay with %(pay_with)s."
msgstr "यो फारम पठाएपछि तपाईं %(pay_with)s बाट भुक्तानी गर्न सक्नुहुन्छ।"

msgid "After you send this form, you can pay in person."
msgstr "यो फारम पठाएपछि तपाईं आफैं आएर भुक्तानी गर्न सक्नुहुन्छ।"

msgid "If you choose monthly, you'll pay the first month now."
msgstr "मासिक रोज्नुभयो भने, पहिलो महिनाको दान अहिले नै तिर्नुहुनेछ।"

msgid "No payment is taken on this website yet. Send this form and we'll contact you about how to pay. If you choose monthly, we'll help you set up a regular payment."
msgstr "यो वेबसाइटमा अहिलेसम्म भुक्तानी लिइँदैन। यो फारम पठाउनुहोस्, कसरी भुक्तानी गर्ने भनेर हामी तपाईंलाई सम्पर्क गर्नेछौं। मासिक रोज्नुभयो भने, नियमित भुक्तानी मिलाउन हामी सहयोग गर्नेछौं।"

msgid "Please check your pledge"
msgstr "कृपया आफ्नो प्रतिबद्धता जाँच्नुहोस्"

msgid "How much would you like to give?"
msgstr "तपाईं कति दान दिन चाहनुहुन्छ?"

msgid "Mobile number"
msgstr "मोबाइल नम्बर"

msgid "optional"
msgstr "वैकल्पिक"

msgid "Your details"
msgstr "तपाईंको विवरण"

msgid "Your choices"
msgstr "तपाईंका रोजाइहरू"

msgid "Continue to payment"
msgstr "भुक्तानीतर्फ जानुहोस्"

msgid "Send my pledge"
msgstr "मेरो प्रतिबद्धता पठाउनुहोस्"

msgid "Thank you"
msgstr "धन्यवाद"

msgid "We've received your pledge and will be in touch soon."
msgstr "हामीले तपाईंको प्रतिबद्धता प्राप्त गर्‍यौं र छिट्टै सम्पर्क गर्नेछौं।"

msgid "See all our appeals"
msgstr "हाम्रा सबै अपिलहरू हेर्नुहोस्"

#, python-format
msgid "Taking you to %(provider)s"
msgstr "तपाईंलाई %(provider)s मा लगिंदै छ"

#, python-format
msgid "Taking you to %(provider)s. If nothing happens, press the button."
msgstr "तपाईंलाई %(provider)s मा लगिंदै छ। केही भएन भने, बटन थिच्नुहोस्।"

#, python-format
msgid "Opening %(provider)s…"
msgstr "%(provider)s खोल्दै…"

#, python-format
msgid "Continue to %(provider)s"
msgstr "%(provider)s मा जानुहोस्"

msgid "This appeal has closed."
msgstr "यो अपिल बन्द भइसकेको छ।"

#, python-format
msgid "%(raised)s raised of %(target)s"
msgstr "%(target)s मध्ये %(raised)s जम्मा भयो"

msgid "Fundraising progress"
msgstr "कोष सङ्कलनको प्रगति"

msgid "Test payment completed. No money was taken."
msgstr "परीक्षण भुक्तानी पूरा भयो। कुनै पैसा लिइएन।"

#, python-format
msgid "This month's gift of %(amount)s has reached us. We'll be in touch about next month."
msgstr "यस महिनाको %(amount)s दान हामीलाई प्राप्त भयो। अर्को महिनाबारे हामी तपाईंलाई सम्पर्क गर्नेछौं।"

#, python-format
msgid "Your gift of %(amount)s has reached us."
msgstr "तपाईंको %(amount)s दान हामीलाई प्राप्त भयो।"

#, python-format
msgid "%(provider)s reference: %(reference)s"
msgstr "%(provider)s सन्दर्भ नम्बर: %(reference)s"

msgid "Back to the home page"
msgstr "गृहपृष्ठमा फर्कनुहोस्"

#, python-format
msgid "We received %(amount)s from you by %(provider)s (reference %(reference)s)."
msgstr "हामीले तपाईंबाट %(provider)s मार्फत %(amount)s पायौं (सन्दर्भ %(reference)s)।"

#, python-format
msgid "We received %(amount)s from you by %(provider)s."
msgstr "हामीले तपाईंबाट %(provider)s मार्फत %(amount)s पायौं।"

msgid "Our team will be in touch."
msgstr "हाम्रो टोलीले तपाईंलाई सम्पर्क गर्नेछ।"

msgid "Pay your gift"
msgstr "तपाईंको दान भुक्तानी गर्नुहोस्"

msgid "How would you like to pay?"
msgstr "तपाईं कसरी भुक्तानी गर्न चाहनुहुन्छ?"

msgid "Pay in person"
msgstr "आफैं आएर भुक्तानी गर्नुहोस्"

msgid "You'll pay this month's gift now."
msgstr "यस महिनाको दान अहिले तिर्नुहुनेछ।"

msgid "Come to our office:"
msgstr "हाम्रो कार्यालयमा आउनुहोस्:"

msgid "Call us before you come:"
msgstr "आउनुअघि हामीलाई फोन गर्नुहोस्:"

msgid "Call us to arrange paying:"
msgstr "भुक्तानी कसरी गर्ने भनेर मिलाउन हामीलाई फोन गर्नुहोस्:"

#, python-format
msgid "Pay in cash and give your pledge number, %(number)s."
msgstr "नगदमा भुक्तानी गर्नुहोस् र आफ्नो प्रतिबद्धता नम्बर %(number)s बताउनुहोस्।"

msgid "Ask for a receipt."
msgstr "रसिद माग्नुहोस्।"

msgid "This page won't change after you pay: your receipt is your record."
msgstr "तपाईंले भुक्तानी गरेपछि यो पेज बदलिँदैन: तपाईंको रसिद नै तपाईंको प्रमाण हो।"

msgid "There's nothing more to do here."
msgstr "यहाँ अरू केही गर्नुपर्दैन।"

msgid "Press and hold the value to copy it."
msgstr "प्रतिलिपि गर्न यो मान थिचिराख्नुहोस्।"

msgid "Pay another way"
msgstr "अर्को तरिकाले भुक्तानी गर्नुहोस्"

msgid "Your pledge is saved."
msgstr "तपाईंको प्रतिबद्धता सुरक्षित भयो।"

msgid "Your gift"
msgstr "तपाईंको दान"

#, python-format
msgid "%(amount)s a month"
msgstr "मासिक %(amount)s"

msgid "Appeal"
msgstr "अपिल"

msgid "Pledge number"
msgstr "प्रतिबद्धता नम्बर"

msgid "Pay online"
msgstr "अनलाइनबाट भुक्तानी गर्नुहोस्"

msgid "Scan our QR code"
msgstr "हाम्रो QR कोड स्क्यान गर्नुहोस्"

msgid "With your bank or wallet app"
msgstr "आफ्नो बैंक वा वालेट एपबाट"

msgid "At our office"
msgstr "हाम्रो कार्यालयमा"

msgid "Not ready to pay yet?"
msgstr "अहिले भुक्तानी गर्न तयार हुनुहुन्न?"

msgid "Save the link and come back"
msgstr "लिङ्क राख्नुहोस् र पछि फर्कनुहोस्"

msgid "Keep this link to come back and pay when you're ready:"
msgstr "तयार हुँदा फर्केर भुक्तानी गर्न यो लिङ्क राख्नुहोस्:"

msgid "Copied"
msgstr "कपी भयो"

msgid "Link copied. Keep it somewhere you'll find it."
msgstr "लिङ्क कपी भयो। यसलाई सजिलै भेटिने ठाउँमा राख्नुहोस्।"

msgid "Press Ctrl+C (or ⌘+C) to copy the selected link."
msgstr "छानिएको लिङ्क कपी गर्न Ctrl+C (वा ⌘+C) थिच्नुहोस्।"

msgid "Copy link"
msgstr "लिङ्क कपी गर्नुहोस्"

msgid "Try paying again"
msgstr "फेरि भुक्तानी गरेर हेर्नुहोस्"

msgid "Check your payment"
msgstr "आफ्नो भुक्तानी जाँच्नुहोस्"

#, python-format
msgid "We couldn't reach %(provider)s just now."
msgstr "हामी भर्खरै %(provider)s सम्म पुग्न सकेनौं।"

#, python-format
msgid "Try %(others)s, or try again in a few minutes."
msgstr "%(others)s बाट प्रयास गर्नुहोस्, वा केही मिनेटपछि फेरि प्रयास गर्नुहोस्।"

msgid "Try again in a few minutes."
msgstr "केही मिनेटपछि फेरि प्रयास गर्नुहोस्।"

#, python-format
msgid "We asked %(provider)s again just now, and it still says your payment didn't go through."
msgstr "हामीले भर्खरै %(provider)s सँग फेरि सोध्यौं, र उसले अझै पनि तपाईंको भुक्तानी पूरा भएन भन्छ।"

#, python-format
msgid "%(provider)s says your payment didn't go through."
msgstr "%(provider)s अनुसार तपाईंको भुक्तानी पूरा भएन।"

msgid "If money has left your account, don't pay again. Call us and we'll look into it:"
msgstr "तपाईंको खाताबाट पैसा गइसकेको छ भने फेरि भुक्तानी नगर्नुहोस्। हामीलाई फोन गर्नुहोस्, हामी हेरिदिन्छौं:"

msgid "If money has left your account, don't pay again."
msgstr "तपाईंको खाताबाट पैसा गइसकेको छ भने फेरि भुक्तानी नगर्नुहोस्।"

#, python-format
msgid "Check my %(provider)s payment"
msgstr "मेरो %(provider)s भुक्तानी जाँच्नुहोस्"

msgid "Your payment didn't go through, and no money was taken. You can try again, or pay another way."
msgstr "तपाईंको भुक्तानी पूरा भएन, र कुनै पैसा लिइएन। फेरि प्रयास गर्न, वा अर्को तरिकाले तिर्न सक्नुहुन्छ।"

msgid "You've told us you paid by scanning our QR code. Our team will check it reaches us, so you don't need to pay again."
msgstr "तपाईंले हाम्रो QR कोड स्क्यान गरेर भुक्तानी गरेको हामीलाई जानकारी गराउनुभएको छ। हाम्रो टोलीले यो हामीसम्म पुगेको जाँच्नेछ, त्यसैले फेरि भुक्तानी गर्नुपर्दैन।"

msgid "See what you told us"
msgstr "तपाईंले के जानकारी दिनुभएको थियो हेर्नुहोस्"

#, python-format
msgid "We asked %(provider)s just now, and it hasn't confirmed your payment yet."
msgstr "हामीले भर्खरै %(provider)s सँग सोध्यौं, तर उसले तपाईंको भुक्तानी अझै पुष्टि गरेको छैन।"

#, python-format
msgid "Did you finish paying with %(provider)s? Check before paying again, so you don't pay twice."
msgstr "के तपाईंले %(provider)s बाट भुक्तानी पूरा गर्नुभयो? दुई पटक नतिर्नका लागि, फेरि तिर्नुअघि जाँच्नुहोस्।"

msgid "I didn't pay: choose a way to pay"
msgstr "मैले भुक्तानी गरेको छैन: भुक्तानी गर्ने तरिका छान्नुहोस्"

#, python-format
msgid "You'll pay on the secure page of %(pay_with)s, then come back here."
msgstr "तपाईं %(pay_with)s को सुरक्षित पृष्ठमा भुक्तानी गर्नुहुनेछ, अनि यहाँ फिर्ता आउनुहुनेछ।"

msgid "Online payments are in test mode here: no money will be taken."
msgstr "यहाँ अनलाइन भुक्तानी परीक्षण मोडमा छ: कुनै पैसा लिइने छैन।"

#, python-format
msgid "Pay with %(provider)s"
msgstr "%(provider)s बाट तिर्नुहोस्"

msgid "Checking your payment"
msgstr "तपाईंको भुक्तानी जाँचिँदैछ"

msgid "We haven't found your payment"
msgstr "हामीले तपाईंको भुक्तानी भेटेका छैनौं"

#, python-format
msgid "Thank you. You've told us you paid %(amount)s by %(name)s on %(date)s. Our team will check it reaches us and mark your gift received."
msgstr "धन्यवाद। तपाईंले %(date)s मा %(name)s बाट %(amount)s भुक्तानी गरेको हामीलाई जानकारी गराउनुभएको छ। हाम्रो टोलीले यो हामीसम्म पुगेको जाँचेर तपाईंको दान प्राप्त भएको जनाउनेछ।"

#, python-format
msgid "You sent us the transaction ID %(id)s."
msgstr "तपाईंले पठाउनुभएको लेनदेन आईडी %(id)s हो।"

msgid "Questions? Call us:"
