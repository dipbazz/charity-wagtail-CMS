{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*pytest*)",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pytest_scope.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_stylesheet.py\"",
            "asyncRewake": true,
            "statusMessage": "Checking the stylesheet"
          }
        ]
      }
    ]
  }
}
